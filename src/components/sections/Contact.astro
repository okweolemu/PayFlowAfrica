---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Mail from '@lucide/astro/icons/mail';
import Sprout from '@lucide/astro/icons/sprout';
import { site } from '../../config/site';
---

<section id="contact" class="section section--muted contact" aria-labelledby="contact-title">
  <div class="container contact__inner">
    <div class="contact__copy">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title" class="contact__title">Get in touch</h2>
      <p class="lead">
        Questions about PayFlow Africa, partnership ideas, or thoughts on what your organisation needs from payroll and
        HR software. We’d like to hear from you.
      </p>
    </div>

    <ul class="contact__options" role="list">
      <li class="contact__option">
        <span class="contact__icon"><Mail /></span>
        <h3>Email</h3>
        <p>General enquiries, partnership ideas and product feedback.</p>
        <p>
          <a class="contact__email" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        </p>
      </li>
      <li class="contact__option">
        <span class="contact__icon"><Sprout /></span>
        <h3>Early access</h3>
        <p>Register your organisation’s interest and help shape what we build first.</p>
        <a class="contact__link" href="#early-access">
          Go to the early-access form
          <ArrowRight />
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact__inner {
    display: grid;
    gap: clamp(2rem, 1.5rem + 3vw, 4rem);
    align-items: center;
  }

  @media (min-width: 64em) {
    .contact__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }
  }

  .contact__copy {
    display: grid;
    gap: var(--space-4);
    max-width: 34rem;
  }

  .contact__title {
    font-size: var(--text-2xl);
    letter-spacing: -0.028em;
  }

  .contact__options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
  }

  .contact__option {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .contact__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: var(--space-2);
    border-radius: 11px;
    background: var(--green-50);
    color: var(--green-700);
  }

  .contact__icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .contact__option h3 {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .contact__option p {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .contact__email {
    color: var(--green-700);
    font-size: var(--text-md);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .contact__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-2);
    color: var(--green-700);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .contact__link:hover {
    text-decoration: underline;
  }

  .contact__link :global(svg) {
    width: 1rem;
    height: 1rem;
  }
</style>
