---
import Check from '@lucide/astro/icons/check';
import EarlyAccessForm from '../EarlyAccessForm.astro';

const expectations = [
  'Updates as the product takes shape',
  'A chance to share the payroll and HR problems you most want solved',
  'Consideration for early previews before general release',
];
---

<section id="early-access" class="section early on-dark" aria-labelledby="early-title">
  <div class="contour-bg" aria-hidden="true"></div>
  <div class="early__glow" aria-hidden="true"></div>

  <div class="container early__inner">
    <div class="early__copy">
      <p class="eyebrow">Early access</p>
      <h2 id="early-title" class="early__title">We’re building the future of payroll and HR in Africa.</h2>
      <p class="lead">
        PayFlow Africa is currently being developed with a focus on making payroll and HR operations simpler, more
        accurate and more useful for organisations across Africa.
      </p>

      <div class="early__expect">
        <h3 class="early__subtitle">What joining means</h3>
        <ul class="early__list" role="list">
          {
            expectations.map((item) => (
              <li>
                <Check class="early__check" />
                {item}
              </li>
            ))
          }
        </ul>
        <p class="early__note">Joining is free and carries no obligation.</p>
      </div>
    </div>

    <div class="early__card on-light">
      <EarlyAccessForm />
    </div>
  </div>
</section>

<style>
  .early {
    overflow: hidden;
  }

  .early__glow {
    position: absolute;
    right: -10%;
    bottom: -30%;
    width: min(60rem, 120%);
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(60 203 145 / 0.12), transparent);
    pointer-events: none;
  }

  .early__inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
    align-items: start;
  }

  @media (min-width: 64em) {
    .early__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }

    .early__copy {
      position: sticky;
      top: calc(var(--header-height) + 2.5rem);
    }
  }

  .early__copy {
    display: grid;
    gap: var(--space-5);
  }

  .early__title {
    font-size: var(--text-2xl);
    letter-spacing: -0.028em;
  }

  .early__expect {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .early__subtitle {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .early__list {
    display: grid;
    gap: var(--space-3);
  }

  .early__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    color: var(--ink-200);
  }

  .early__list :global(.early__check) {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    padding: 0.2rem;
    border-radius: 50%;
    background: rgb(60 203 145 / 0.15);
    color: var(--green-400);
    stroke-width: 3;
  }

  .early__note {
    color: var(--ink-300);
    font-size: var(--text-sm);
  }

  .early__card {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius-xl);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
  }
</style>
