---
import '../../styles/mockup.css';
import Check from '@lucide/astro/icons/check';
import SlidersHorizontal from '@lucide/astro/icons/sliders-horizontal';
import { rule } from '../../data/sample';
---

<div class="m-frame">
  <div class="m-app rule" aria-hidden="true">
    <div class="rule__head">
      <span class="rule__icon"><SlidersHorizontal /></span>
      <div class="rule__title">
        <p class="rule__kicker">Payroll rule · Statutory deduction</p>
        <p class="rule__name">{rule.name}</p>
      </div>
      <span class="m-badge is-success">{rule.version} · Active</span>
    </div>

    <dl class="m-fields rule__fields">
      {
        rule.fields.map(([label, value]) => (
          <div class="m-field">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="rule__block">
      <p class="rule__label">Change history</p>
      <ol class="m-timeline">
        {
          rule.history.map((entry) => (
            <li class:list={['m-timeline-item', { 'is-past': !entry.current }]}>
              <span class="m-timeline-dot">
                {entry.current ? <Check /> : <span class="rule__version">{entry.version}</span>}
              </span>
              <span>
                <span class="m-strong">
                  {entry.version} · {entry.text}
                </span>
                <span class="rule__meta">{entry.meta}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="rule__block rule__currencies">
      <p class="rule__label">Pay currencies in this organisation</p>
      <div class="rule__chips">
        {rule.currencies.map((code) => <span class="m-chip">{code}</span>)}
      </div>
    </div>
  </div>
</div>

<style>
  .rule {
    display: grid;
    gap: 1.25em;
    padding: 1.4em 1.5em 1.5em;
    font-size: clamp(11.5px, 0.55rem + 0.9cqi, 14px);
    box-shadow: 0 32px 64px -24px rgb(0 0 0 / 0.55);
  }

  .rule__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85em;
  }

  .rule__icon {
    display: grid;
    place-items: center;
    width: 2.5em;
    height: 2.5em;
    border-radius: 9px;
    background: var(--m-accent-soft);
    color: var(--m-accent);
  }

  .rule__kicker,
  .rule__label {
    color: var(--m-muted);
    font-size: 0.82em;
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .rule__name {
    font-size: 1.15em;
    font-weight: 650;
    line-height: 1.3;
  }

  .rule__fields {
    padding: 1em 1.1em;
    border-radius: 10px;
    background: var(--m-bg);
  }

  .rule__block {
    display: grid;
    gap: 0.75em;
  }

  .rule__meta {
    display: block;
    color: var(--m-muted);
    font-size: 0.9em;
  }

  .is-past .m-timeline-dot {
    background: var(--m-bg);
    color: var(--m-muted);
  }

  .rule__version {
    font-size: 0.72em;
    font-weight: 700;
  }

  .rule__currencies {
    padding-top: 1.1em;
    border-top: 1px solid var(--m-border);
  }

  .rule__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45em;
  }

  @container (max-width: 380px) {
    .rule__head {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .rule__head .m-badge {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
