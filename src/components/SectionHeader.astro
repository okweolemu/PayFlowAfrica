---
interface Props {
  /** Id of the heading, referenced by the section's aria-labelledby. */
  id: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
}

const { id, eyebrow, title, lead, align = 'start' } = Astro.props;
---

<header class:list={['section-header', { 'section-header--center': align === 'center' }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="section-header__title">{title}</h2>
  {lead && <p class="section-header__lead">{lead}</p>}
  <slot />
</header>
