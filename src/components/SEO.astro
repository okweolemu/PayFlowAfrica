---
import { site } from '../config/site';
import type { Faq } from '../data/content';

interface Props {
  /** Page-specific title; the home page uses the full site title. */
  title?: string;
  description?: string;
  noindex?: boolean;
  faqs?: Faq[];
}

const { title, description = site.description, noindex = false, faqs = [] } = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : site.title;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;
const home = new URL('/', Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const ogImageAlt = `${site.name} — ${site.tagline}`;

// One linked graph: the organisation, the website it publishes, and this page. Search engines use the WebSite node
// for the site name shown in results; AI assistants use the whole graph to describe the company accurately.
const organisationId = `${home}#organization`;
const websiteId = `${home}#website`;

const organisation = {
  '@type': 'Organization',
  '@id': organisationId,
  name: site.name,
  alternateName: site.alternateNames,
  url: home,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/icon-512.png', Astro.site).href,
    width: 512,
    height: 512,
  },
  description: site.description,
  slogan: site.tagline,
  email: site.contactEmail,
  knowsAbout: ['Payroll', 'Payroll software', 'HR software', 'Human resource management'],
  ...(site.sameAs.length > 0 && { sameAs: site.sameAs }),
};

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: home,
  name: site.name,
  alternateName: [...site.alternateNames, site.domain],
  description: site.summary,
  inLanguage: 'en-GB',
  publisher: { '@id': organisationId },
};

const webPage = {
  '@type': faqs.length > 0 ? ['WebPage', 'FAQPage'] : 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: pageTitle,
  description,
  inLanguage: 'en-GB',
  isPartOf: { '@id': websiteId },
  ...(canonical === home && { about: { '@id': organisationId } }),
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
  ...(faqs.length > 0 && {
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  }),
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': noindex ? [organisation, website] : [organisation, website, webPage],
};
// Escape "<" so text in the data can never close the script element.
const jsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{
  noindex ? (
    <meta name="robots" content="noindex" />
  ) : (
    <>
      <meta name="robots" content="max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
      <link rel="canonical" href={canonical} />
    </>
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content={site.themeColor} />

<script type="application/ld+json" is:inline set:html={jsonLd} />
