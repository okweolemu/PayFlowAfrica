# Copy to .env for local builds, or set as an environment variable in
# Cloudflare Pages (Settings → Variables and Secrets → Production).

# Optional https:// endpoint that accepts the early-access form as a JSON POST
# (e.g. a Formspree form URL or your own Cloudflare Worker). When unset, the form
# opens the visitor's email app with a request addressed to the contact email
# set in src/config/site.ts.
PUBLIC_EARLY_ACCESS_ENDPOINT=
