{
  "name": "payflowafrica-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public website for PayFlow Africa (payflowafrica.com).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check && eslint .",
    "pretest": "astro build",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "npm run lint && npm test",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/astro": "^1.52.0",
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "node-html-parser": "^9.0.4",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
